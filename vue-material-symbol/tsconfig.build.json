{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist",
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve"
  },
  "include": ["./**/*.ts", "./**/*.vue"],
  "exclude": [
    "dist",
    "node_modules",
    "vite.config.ts",
    "vitest.config.ts",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
