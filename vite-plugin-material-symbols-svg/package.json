{
  "name": "@hyrioo/vite-plugin-material-symbols-svg",
  "version": "0.2.0",
  "description": "Vite plugin for Material Symbols SVG icons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyrioo/material-symbols-svg.git",
    "directory": "vite-plugin-material-symbols-svg"
  },
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && yarn build:types",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest run",
    "mpack": "yarn pack --filename hyrioo-vite-plugin-material-symbols-svg.tgz"
  },
  "peerDependencies": {
    "@hyrioo/vue-material-symbol": "^0.2.0",
    "vite": ">=4.0.0"
  },
  "dependencies": {
    "esbuild": "^0.25.10"
  },
  "devDependencies": {
    "@hyrioo/vue-material-symbol": "^0.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
